{
  "Tenant": {
    "InstanceId": "<TENANT_INSTANCE_GUID>",
    "Adapter": "Sql",
    "Sql": {
      "Host": "<SQL_SERVER_FQDN>",
      "Port": 1433,
      "Database": "<TENANT_DATABASE>",
      "User": "<TENANT_RUNTIME_LOGIN>",
      "PasswordReference": "tenant.runtime.sql.password"
    }
  },
  "Access": {
    "Authority": "<HTTPS_IDENTITY_AUTHORITY>",
    "ClientId": "<TENANT_WEB_CLIENT_ID>",
    "ClientSecretReference": "TENANT_OIDC_CLIENT_SECRET",
    "RequiredManagementRole": "<TENANT_MANAGEMENT_ROLE>",
    "RoleClaimType": "roles"
  },
  "DataProtection": {
    "KeyDirectory": "<PROTECTED_TENANT_KEY_DIRECTORY>"
  },
  "Health": {
    "CredentialReference": "<TENANT_HEALTH_CREDENTIAL_REFERENCE>"
  },
  "Retention": {
    "ArchiveRoot": "<TENANT_ARCHIVE_ROOT>"
  }
}
