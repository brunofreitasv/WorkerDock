{
  "Tenant": {
    "InstanceId": "<TENANT_INSTANCE_GUID>",
    "Adapter": "Sql",
    "Sql": {
      "Host": "<SQL_SERVER_FQDN>",
      "Port": 1433,
      "Database": "<TENANT_DATABASE>",
      "User": "<TENANT_RUNTIME_LOGIN>",
      "PasswordReference": "tenant.runtime.sql.password"
    }
  },
  "Worker": {
    "CatalogDigest": "<64_CHARACTER_TEMPLATE_CATALOG_SHA256>",
    "HostCeiling": 10,
    "DrainSeconds": 40
  },
  "Executor": {
    "Path": "<INSTALL_ROOT>\\worker\\executor\\WorkerDock.Executor.exe",
    "Arguments": []
  }
}
