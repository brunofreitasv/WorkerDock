{
  "name": "workerdock-frontend",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest",
    "build": "node scripts/licenses.mjs && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @workerdock/tenant",
    "format": "prettier --write apps packages scripts *.ts *.json"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "type": "module"
}
